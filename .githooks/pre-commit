#!/bin/sh
# Format and validate staged markdown before it is committed.
#
# Enable with:  npm run hooks:install     (sets core.hooksPath to .githooks)
# Skip once with: git commit --no-verify
#
# Only staged files are examined, so this stays fast enough not to be a
# nuisance. The whole-corpus sweep and the Zola build run in CI instead.

set -eu

staged_md=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.md$' || true)
[ -z "$staged_md" ] && exit 0

fail=0

# --- format ---------------------------------------------------------------
# proseWrap comes from .prettierrc; re-stage whatever prettier rewrites so the
# commit contains the formatted version rather than leaving it dirty.
if command -v npx >/dev/null 2>&1; then
  echo "$staged_md" | tr '\n' '\0' | xargs -0 npx --no-install prettier --write --log-level warn 2>/dev/null || true
  echo "$staged_md" | tr '\n' '\0' | xargs -0 git add
fi

# --- cheap syntax guards --------------------------------------------------
# "[label] (target)" does not parse as a link; it renders as literal text.
spaced=$(echo "$staged_md" | xargs grep -nE '\]\s+\((https?://|@/|/|mailto:|#)' 2>/dev/null || true)
if [ -n "$spaced" ]; then
  echo "error: markdown link with a space between ] and ( — it will not render as a link:"
  echo "$spaced" | sed 's/^/    /'
  fail=1
fi

# Heading anchors are identifiers; a translated one breaks every link to it.
anchor=$(echo "$staged_md" | xargs grep -nE '\{#[^}]*[^ -~][^}]*\}' 2>/dev/null || true)
if [ -n "$anchor" ]; then
  echo "error: non-ASCII heading anchor — anchors are identifiers, keep them as in the English source:"
  echo "$anchor" | sed 's/^/    /'
  fail=1
fi

# --- translation invariants ----------------------------------------------
# Only for translated files that have an English sibling.
for f in $staged_md; do
  case "$f" in
    content/*) ;;
    *) continue ;;
  esac
  lang=$(printf '%s' "$f" | sed -nE 's/.*\.([a-zA-Z-]+)\.md$/\1/p')
  [ -z "$lang" ] && continue
  dir=$(dirname "$f")
  case "$(basename "$f")" in
    _index.*) src="$dir/_index.md" ;;
    *)        src="$dir/index.md" ;;
  esac
  [ -f "$src" ] || continue
  python3 translate_check.py "$src" "$f" "$lang" --errors-only || fail=1
done

# --- slug guard (warn, do not block) --------------------------------------
# Slugs are published URLs. Changing one breaks inbound links, but new pages
# legitimately add them, so this warns rather than fails.
slug=$(git diff --cached -U0 | grep -E '^-slug:' || true)
if [ -n "$slug" ]; then
  echo "warning: a slug: line was removed or changed — these are published URLs:"
  echo "$slug" | sed 's/^/    /'
  echo "    (commit anyway if the page is new or the URL change is intended)"
fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "pre-commit checks failed. Fix the above, or bypass with: git commit --no-verify"
  exit 1
fi
exit 0
